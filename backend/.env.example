PORT=5000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_zoho_custom_portal_2026_!@#
JWT_EXPIRES_IN=8h

# Database Configuration (Defaults to SQLite; supports PostgreSQL or MySQL)
DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite

# Zoho One API OAuth Credentials
# You can generate these at https://api-console.zoho.com
ZOHO_CLIENT_ID=your_zoho_client_id_here
ZOHO_CLIENT_SECRET=your_zoho_client_secret_here
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token_here

# Zoho Data Center domain (.com, .in, .eu, .com.au, .com.cn)
# Default is .com (e.g., https://accounts.zoho.com)
ZOHO_DOMAIN=com

# Frontend Application URL for CORS
FRONTEND_URL=http://localhost:5173
